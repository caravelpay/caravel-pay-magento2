<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Payment method facade (Magento payment gateway framework). -->
    <virtualType name="CaravelPayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Caravel\Pay\Model\Ui\ConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">CaravelPayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">CaravelPayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">CaravelPayCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Caravel\Pay\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">CaravelPayGatewayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">CaravelPayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">CaravelPayGatewayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">CaravelPayCountryValidator</item>
                <item name="currency" xsi:type="string">Caravel\Pay\Gateway\Validator\CurrencyValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Caravel\Pay\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Hide the method while the store isn't connected or its merchant isn't active. -->
    <type name="Magento\Payment\Model\Method\Adapter">
        <plugin name="caravel_pay_availability" type="Caravel\Pay\Model\Availability"/>
    </type>

    <!-- Log to var/log/caravel_pay.log. -->
    <virtualType name="CaravelPayLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/caravel_pay.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="CaravelPayMonolog" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">caravel_pay</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">CaravelPayLogHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Caravel\Pay\Model\PsrLogger">
        <arguments>
            <argument name="logger" xsi:type="object">CaravelPayMonolog</argument>
        </arguments>
    </type>

    <!-- One connector instance per request. -->
    <type name="Caravel\Pay\Model\Service" shared="true"/>
</config>
